    "compilerOptions": {
        "paths": {
            "@common/*": [ "./src/common/*" ],
            "@maimai/*": [ "./src/maimai/*" ],
            "@chunithm/*": [ "./src/chunithm/*" ],
            "@ongeki/*": [ "./src/ongeki/*" ],
