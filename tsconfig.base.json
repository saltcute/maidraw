{
    "compilerOptions": {
        "declaration": true,
        "target": "ES2025",
        "module": "nodenext",
        "moduleResolution": "node16",
        "types": ["node"],
        "lib": [
            "ES2025"
        ],
        "strict": true,
        "typeRoots": [
            "node_modules/@types"
        ],
        "esModuleInterop": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    }
}